diff -ruN -x ASH_VERSION.md -x ASH_CHANGES.patch -x 'env_*.sh' -x __pycache__ experiments/amd_prefill_decode_perf_r001/src/sglang/python/sglang/srt/multiplex/greenctx_driver.py sglang_ash/r001/sglang/python/sglang/srt/multiplex/greenctx_driver.py
--- experiments/amd_prefill_decode_perf_r001/src/sglang/python/sglang/srt/multiplex/greenctx_driver.py	1970-01-01 07:30:00.000000000 +0730
+++ sglang_ash/r001/sglang/python/sglang/srt/multiplex/greenctx_driver.py	2026-10-17 19:43:38.177404837 +0800
@@ -0,0 +1,56 @@
+"""Green-context streams through the CUDA driver API (ASH r001, 2026-10-17).
+
+sgl_kernel.spatial.create_greenctx_stream_by_value needs both partitions to be multiples of the architecture granularity (8 SMs on
+Hopper), so e.g. "decode lane = 128 SMs, rest = 4 SMs" cannot be built. Here the device is split ONCE with
+cuDevSmResourceSplitByCount(1 group, minCount=n_first): the first lane gets that group, the second lane gets the remainder (any size).
+Verified on H200 (jobs 148898/149337: fast 128 SMs, remainder 4 SMs, %smid disjoint).
+"""
+from __future__ import annotations
+
+import ctypes
+from typing import Tuple
+
+_cu = None
+
+
+class _DevResource(ctypes.Structure):  # CUdevResource, RESOURCE_ABI_VERSION 1: type, 92 B padding, union (sm.smCount first)
+    _fields_ = [('type', ctypes.c_int), ('pad', ctypes.c_ubyte * 92), ('smCount', ctypes.c_uint), ('rest', ctypes.c_ubyte * 44)]
+
+
+def _driver():
+    global _cu
+    if _cu is None:
+        _cu = ctypes.CDLL('libcuda.so.1')
+    return _cu
+
+
+def _chk(r: int, what: str) -> None:
+    if r != 0:
+        raise RuntimeError(f'{what} -> CUresult {r}')
+
+
+def _stream_on(res_ptr, dev) -> int:
+    cu = _driver()
+    desc = ctypes.c_void_p(); _chk(cu.cuDevResourceGenerateDesc(ctypes.byref(desc), res_ptr, 1), 'cuDevResourceGenerateDesc')
+    g = ctypes.c_void_p(); _chk(cu.cuGreenCtxCreate(ctypes.byref(g), desc, dev, 1), 'cuGreenCtxCreate')   # CU_GREEN_CTX_DEFAULT_STREAM
+    s = ctypes.c_void_p(); _chk(cu.cuGreenCtxStreamCreate(ctypes.byref(s), g, 1, 0), 'cuGreenCtxStreamCreate')  # NON_BLOCKING
+    return s.value
+
+
+def create_split_streams(n_first: int, gpu_id: int) -> Tuple[list, Tuple[int, int]]:
+    """Two green-context streams: n_first SMs (rounded by the driver to the arch granularity) and all remaining SMs."""
+    import torch
+    torch.zeros(1, device=f'cuda:{gpu_id}')           # primary context exists before the green contexts
+    cu = _driver()
+    dev = ctypes.c_int(); _chk(cu.cuDeviceGet(ctypes.byref(dev), gpu_id), 'cuDeviceGet')
+    full = _DevResource(); _chk(cu.cuDeviceGetDevResource(dev, ctypes.byref(full), 1), 'cuDeviceGetDevResource')  # CU_DEV_RESOURCE_TYPE_SM
+    grp, rem, ng = (_DevResource * 1)(), _DevResource(), ctypes.c_uint(1)
+    _chk(cu.cuDevSmResourceSplitByCount(grp, ctypes.byref(ng), ctypes.byref(full), ctypes.byref(rem), 0, int(n_first)),
+         'cuDevSmResourceSplitByCount')
+    if rem.smCount == 0:
+        raise ValueError(f'no SMs left for the second lane after taking {grp[0].smCount}')
+    s0 = _stream_on(ctypes.pointer(grp[0]), dev)
+    s1 = _stream_on(ctypes.pointer(rem), dev)
+    d = torch.device(f'cuda:{gpu_id}')
+    return ([torch.cuda.ExternalStream(stream_ptr=s0, device=d), torch.cuda.ExternalStream(stream_ptr=s1, device=d)],
+            (int(grp[0].smCount), int(rem.smCount)))
diff -ruN -x ASH_VERSION.md -x ASH_CHANGES.patch -x 'env_*.sh' -x __pycache__ experiments/amd_prefill_decode_perf_r001/src/sglang/python/sglang/srt/multiplex/sm_budget.py sglang_ash/r001/sglang/python/sglang/srt/multiplex/sm_budget.py
--- experiments/amd_prefill_decode_perf_r001/src/sglang/python/sglang/srt/multiplex/sm_budget.py	1970-01-01 07:30:00.000000000 +0730
+++ sglang_ash/r001/sglang/python/sglang/srt/multiplex/sm_budget.py	2026-10-17 19:53:10.204377649 +0800
@@ -0,0 +1,110 @@
+"""SM budget of the code that is being captured / launched right now (ASH r001, 2026-10-17).
+
+A green-context decode lane only owns part of the GPU. Kernels whose launch configuration depends on the SM count (persistent grids,
+split-KV heuristics, tuned Triton configs, cuBLAS algorithm choice) must be configured for the lane's SMs, not for the whole device.
+``sm_budget(n)`` is entered while a lane's CUDA graph is captured (and around eager lane forwards); it
+  * makes ``current_sm_budget()`` return n (read by FlashAttention, fused-MoE config lookup, MoE sum-reduce selection),
+  * sets deep_gemm's SM count,
+  * sets the cuBLAS / cuBLASLt SM-count target via torch's SM carveout.
+Outside a budget everything sees the full device.
+"""
+from __future__ import annotations
+
+import contextlib
+import functools
+from typing import Optional
+
+import torch
+
+_BUDGET: Optional[int] = None
+_WARNED = set()
+
+
+def _warn_once(msg: str) -> None:
+    if msg not in _WARNED:
+        _WARNED.add(msg)
+        import logging
+        logging.getLogger(__name__).warning(msg)
+
+
+@functools.lru_cache(maxsize=None)
+def full_sm_count(device: Optional[int] = None) -> int:
+    dev = torch.cuda.current_device() if device is None else device
+    return int(torch.cuda.get_device_properties(dev).multi_processor_count)
+
+
+def current_sm_budget() -> int:
+    """SMs available to the kernels being configured now (full device outside any lane budget)."""
+    return _BUDGET if _BUDGET is not None else full_sm_count()
+
+
+def is_partial_budget() -> bool:
+    return _BUDGET is not None and _BUDGET < full_sm_count()
+
+
+def _deep_gemm():
+    try:
+        import deep_gemm  # noqa: F401
+        return deep_gemm if hasattr(deep_gemm, 'set_num_sms') else None
+    except Exception:
+        return None
+
+
+@contextlib.contextmanager
+def sm_budget(n: Optional[int]):
+    """Configure SM-count-dependent kernels for ``n`` SMs inside this block (no-op when n is None or the full device)."""
+    global _BUDGET
+    full = full_sm_count()
+    if not n or n >= full:
+        yield
+        return
+    prev = _BUDGET
+    dg = _deep_gemm()
+    prev_dg = None
+    if dg is not None:
+        try:
+            prev_dg = dg.get_num_sms()
+        except Exception as e:  # deep_gemm not usable here (e.g. no CUDA context): skip it, the rest still applies
+            _warn_once(f"sm_budget: deep_gemm SM count not adjusted ({e})")
+            dg = None
+    prev_carveout = torch._C._get_sm_carveout_experimental() if hasattr(torch._C, '_get_sm_carveout_experimental') else None
+    _BUDGET = int(n)
+    try:
+        if dg is not None:
+            dg.set_num_sms(int(n))
+        if hasattr(torch._C, '_set_sm_carveout_experimental'):
+            torch._C._set_sm_carveout_experimental(full - int(n))
+        yield
+    finally:
+        _BUDGET = prev
+        if dg is not None and prev_dg is not None:
+            dg.set_num_sms(prev_dg)
+        if hasattr(torch._C, '_set_sm_carveout_experimental'):
+            torch._C._set_sm_carveout_experimental(prev_carveout)
+
+
+def _find_backends(b, cls, depth=0, seen=None):
+    seen = set() if seen is None else seen
+    if b is None or id(b) in seen or depth > 4:
+        return []
+    seen.add(id(b))
+    if isinstance(b, cls):
+        return [b]
+    out = []
+    for v in (vars(b).values() if hasattr(b, '__dict__') else []):
+        if isinstance(v, (list, tuple)):
+            for x in v:
+                out += _find_backends(x, cls, depth + 1, seen)
+        elif type(v).__module__.startswith('sglang.srt.layers.attention'):
+            out += _find_backends(v, cls, depth + 1, seen)
+    return out
+
+
+def set_lane_sm_count(attn_backend, n: Optional[int]) -> int:
+    """Record a decode lane's SM count on every FlashAttention (FA3) backend inside ``attn_backend`` (e.g. the full-attention backend
+    of HybridLinearAttnBackend). The FA3 backend uses it at capture AND replay to pick the KV split for these SMs. Returns #backends."""
+    from sglang.srt.layers.attention.flashattention_backend import FlashAttentionBackend
+    fabs = _find_backends(attn_backend, FlashAttentionBackend)
+    for f in fabs:
+        f.lane_sm_count = int(n) if n and n < full_sm_count() else None
+    return len(fabs)
diff -ruN -x ASH_VERSION.md -x ASH_CHANGES.patch -x 'env_*.sh' -x __pycache__ experiments/amd_prefill_decode_perf_r001/src/sglang/test/ash/test_fa3_lane_split_gpu.py sglang_ash/r001/sglang/test/ash/test_fa3_lane_split_gpu.py
--- experiments/amd_prefill_decode_perf_r001/src/sglang/test/ash/test_fa3_lane_split_gpu.py	1970-01-01 07:30:00.000000000 +0730
+++ sglang_ash/r001/sglang/test/ash/test_fa3_lane_split_gpu.py	2026-10-17 19:58:43.436779265 +0800
@@ -0,0 +1,68 @@
+"""GPU check of the FA3 lane split (ASH r001): for decode shapes of Qwen3.6 full attention (16 Q heads, 2 KV heads, head_dim 256,
+bf16 KV, page_size 1) compare, per lane SM count, the lane configuration used by FlashAttentionBackend (num_splits from
+choose_lane_num_splits, metadata from fa3_metadata_num_sm, kernel sm_margin = full - n) with the unsplit reference, and time it
+against the stock configuration (kernel margin only). Run on one H200: python test/ash/test_fa3_lane_split_gpu.py [--out f.json]"""
+import argparse
+import json
+import math
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'python'))
+import torch  # noqa: E402
+from sgl_kernel.flash_attn import flash_attn_with_kvcache, get_scheduler_metadata  # noqa: E402
+
+from sglang.srt.layers.attention.flashattention_backend import choose_lane_num_splits, fa3_metadata_num_sm  # noqa: E402
+
+HQ, HK, D = 16, 2, 256
+
+
+def run_case(B, L, kern_margin, meta_margin, ns, q, k, v, iters=20):
+    pt = torch.arange(B * L, device='cuda', dtype=torch.int32).view(B, L)
+    seq = torch.full((B,), L, device='cuda', dtype=torch.int32); cu = torch.arange(0, B + 1, device='cuda', dtype=torch.int32)
+    meta = None
+    if meta_margin is not None:
+        meta = get_scheduler_metadata(batch_size=B, max_seqlen_q=1, max_seqlen_k=L, num_heads=HQ, num_heads_k=HK, headdim=D,
+                                      cache_seqlens=seq, qkv_dtype=torch.bfloat16, cu_seqlens_q=cu, page_size=1, causal=True,
+                                      num_splits=ns, sm_margin=meta_margin)
+    f = lambda: flash_attn_with_kvcache(q, k, v, cache_seqlens=seq, page_table=pt, cu_seqlens_q=cu, max_seqlen_q=1,
+                                        softmax_scale=1 / math.sqrt(D), causal=True, num_splits=ns, scheduler_metadata=meta,
+                                        sm_margin=kern_margin)
+    out = f(); torch.cuda.synchronize()
+    e0, e1 = torch.cuda.Event(True), torch.cuda.Event(True); e0.record()
+    for _ in range(iters):
+        f()
+    e1.record(); torch.cuda.synchronize()
+    return out.float(), e0.elapsed_time(e1) / iters * 1e3
+
+
+def main():
+    ap = argparse.ArgumentParser(); ap.add_argument('--out', default=None); a = ap.parse_args()
+    torch.manual_seed(0)
+    full = torch.cuda.get_device_properties(0).multi_processor_count
+    res, ok = [], True
+    for B in (1, 8, 32):
+        for L in (4096, 51200):
+            q = torch.randn(B, HQ, D, device='cuda', dtype=torch.bfloat16)
+            k = torch.randn(B * L, 1, HK, D, device='cuda', dtype=torch.bfloat16)
+            v = torch.randn(B * L, 1, HK, D, device='cuda', dtype=torch.bfloat16)
+            ref, t_ref = run_case(B, L, 0, None, 1, q, k, v)
+            for n in (96, 112, 128):
+                tiles = B * HK; s = choose_lane_num_splits(tiles, n); virt = fa3_metadata_num_sm(tiles, s, n)
+                o_fix, t_fix = run_case(B, L, full - n, full - virt, s, q, k, v)
+                o_stk, t_stk = run_case(B, L, full - n, 0, 0, q, k, v)
+                d_fix = float((o_fix - ref).abs().max()); d_stk = float((o_stk - ref).abs().max())
+                good = bool(torch.isfinite(o_fix).all()) and d_fix <= max(2e-3, 2 * d_stk + 1e-4)
+                ok &= good
+                r = dict(B=B, L=L, sms=n, num_splits=s, meta_num_sm=virt, lane_us=round(t_fix, 1), stock_us=round(t_stk, 1),
+                         nosplit_full_us=round(t_ref, 1), max_abs_vs_nosplit=d_fix, stock_max_abs_vs_nosplit=d_stk, ok=good)
+                res.append(r); print(json.dumps(r), flush=True)
+            del k, v; torch.cuda.empty_cache()
+    print('ALL_OK' if ok else 'FAILED', flush=True)
+    if a.out:
+        json.dump(res, open(a.out, 'w'), indent=1)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == '__main__':
+    main()
diff -ruN -x ASH_VERSION.md -x ASH_CHANGES.patch -x 'env_*.sh' -x __pycache__ experiments/amd_prefill_decode_perf_r001/src/sglang/test/ash/test_sm_budget.py sglang_ash/r001/sglang/test/ash/test_sm_budget.py
--- experiments/amd_prefill_decode_perf_r001/src/sglang/test/ash/test_sm_budget.py	1970-01-01 07:30:00.000000000 +0730
+++ sglang_ash/r001/sglang/test/ash/test_sm_budget.py	2026-10-17 19:57:04.213957439 +0800
@@ -0,0 +1,92 @@
+"""Unit tests for the ASH r001 green-context lane changes (CPU only; run: python test/ash/test_sm_budget.py, or pytest).
+Covers: FA3 lane split choice, the virtual SM count vs FA3's dynamic split rule, the long_green_ctx_sm_count = -1 sentinel, the
+SM-count-specific fused-MoE config file names, and the sm_budget context (without a GPU, by faking the device SM count)."""
+import math
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'python'))
+
+import sglang.srt.multiplex.sm_budget as smb  # noqa: E402
+
+
+def fa3_dynamic_splits(n_blocks, batch, kv_heads, num_sm, num_splits_cap):
+    """FA3 scheduler-metadata prepare rule (flash_prepare_scheduler.cu) for equal-length decode requests."""
+    total_blocks = n_blocks * batch
+    blocks_per_sm = math.ceil(total_blocks * 1.1 * kv_heads / num_sm)
+    return max(min(math.ceil(n_blocks / blocks_per_sm), num_splits_cap), 1)
+
+
+def test_choose_lane_num_splits():
+    from sglang.srt.layers.attention.flashattention_backend import choose_lane_num_splits
+    assert choose_lane_num_splits(64, 128) == 2
+    assert choose_lane_num_splits(64, 112) == 7      # 448 tiles = 4 full waves
+    assert choose_lane_num_splits(64, 96) == 3       # 192 tiles = 2 full waves
+    assert choose_lane_num_splits(32, 32) == 1
+    assert choose_lane_num_splits(32, 16) == 1
+    for tiles in range(1, 200):
+        for n in (16, 32, 64, 96, 112, 128):
+            s = choose_lane_num_splits(tiles, n)
+            assert 1 <= s <= 16
+
+
+def test_virtual_num_sm_hits_target_split():
+    from sglang.srt.layers.attention.flashattention_backend import choose_lane_num_splits, fa3_metadata_num_sm
+    for batch in (1, 4, 8, 16, 32, 48, 64):
+        for kv in (1, 2, 4, 8):
+            for n in (96, 112, 128):
+                tiles = batch * kv
+                s = choose_lane_num_splits(tiles, n)
+                virt = fa3_metadata_num_sm(tiles, s, n)
+                for ctx in (4096, 16384, 32768, 51200, 131072):
+                    n_blocks = math.ceil(ctx / 128)
+                    if n_blocks < s:
+                        continue
+                    got = fa3_dynamic_splits(n_blocks, batch, kv, virt, s)
+                    if n_blocks >= 2 * s:     # long enough for the split to matter: must hit the target exactly
+                        assert got == s, (batch, kv, n, ctx, s, virt, got)
+                    else:                     # short contexts: the dynamic rule may use fewer splits (never more)
+                        assert 1 <= got <= s, (batch, kv, n, ctx, s, virt, got)
+
+
+def test_long_lane_remainder_sentinel():
+    from sglang.srt.multiplex.decode_lane_context import _resolve_green_ctx_sm_counts
+    assert _resolve_green_ctx_sm_counts(128, -1, 132, 8) == (128, 4)
+    assert _resolve_green_ctx_sm_counts(96, -1, 132, 8) == (96, 36)
+    assert _resolve_green_ctx_sm_counts(96, 32, 132, 8) == (96, 32)    # unchanged behaviour
+    for bad in ((0, -1), (132, -1), (100, -1)):
+        try:
+            _resolve_green_ctx_sm_counts(bad[0], bad[1], 132, 8)
+            raise AssertionError(f'expected ValueError for {bad}')
+        except ValueError:
+            pass
+
+
+def test_moe_config_file_names():
+    import sglang.srt.layers.moe.moe_runner.triton_utils.fused_moe_triton_config as c
+    c.get_device_name = lambda: 'NVIDIA H200'
+    full = c.get_config_file_name(256, 512, 'fp8_w8a8', [128, 128])
+    lane = c.get_config_file_name(256, 512, 'fp8_w8a8', [128, 128], sm_count=96)
+    down = c.get_config_file_name(256, 512, 'fp8_w8a8', [128, 128], down_moe=True, sm_count=96)
+    assert full == 'E=256,N=512,device_name=NVIDIA_H200,dtype=fp8_w8a8,block_shape=[128, 128].json', full
+    assert lane == 'E=256,N=512,device_name=NVIDIA_H200,sms=96,dtype=fp8_w8a8,block_shape=[128, 128].json', lane
+    assert down.endswith('block_shape=[128, 128]_down.json') and ',sms=96,' in down
+
+
+def test_sm_budget_context():
+    smb.full_sm_count.cache_clear()
+    smb.full_sm_count = lambda device=None: 132          # no GPU needed
+    assert smb.current_sm_budget() == 132 and not smb.is_partial_budget()
+    with smb.sm_budget(96):
+        assert smb.current_sm_budget() == 96 and smb.is_partial_budget()
+        with smb.sm_budget(None):                         # no-op inside
+            assert smb.current_sm_budget() == 96
+    assert smb.current_sm_budget() == 132
+    with smb.sm_budget(132):                              # full device = no budget
+        assert not smb.is_partial_budget()
+
+
+if __name__ == '__main__':
+    for name, fn in sorted(globals().items()):
+        if name.startswith('test_') and callable(fn):
+            fn(); print('ok', name)
